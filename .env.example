# Environment Variables Template
# Copy this file to .env.development, .env.staging, and .env.production
# Update values for each environment

# API Configuration
API_BASE_URL=https://backend-cfh1.onrender.com/api/v1
API_TIMEOUT=30000

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:platform:app_id_here
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google OAuth
GOOGLE_WEB_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Environment
NODE_ENV=development
